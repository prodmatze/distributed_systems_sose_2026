# Copy this file to `.env` in the same directory and fill in real values for local dev.
# The `.env` file is gitignored — never commit credentials.

# --- Postgres ---
# Used by the postgres container AND interpolated into DATABASE_URL in docker-compose.yml.
POSTGRES_USER=chorus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chorus

# --- JWT signing ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
